# Placeholders only. Never commit real values. Copy to .env at the repo root.
APP_ENV=local                 # local | test | poc | production
APP_URL=http://localhost:3000
DATABASE_URL=                 # Neon POOLED connection string (host contains -pooler)
DIRECT_URL=                   # Neon DIRECT connection string (used by migrations)
JWT_SECRET=                   # >= 32 random bytes, e.g. openssl rand -base64url 48
MFA_ENC_KEY=                  # base64 of 32 random bytes, e.g. openssl rand -base64 32
SEED_DEMO_PASSWORD=           # shared password for demo accounts (never committed)
CRON_SECRET=                  # Vercel Cron bearer secret
RESEND_API_KEY=               # empty = emails are printed to the server log
SMTP_USER=                    # Gmail address; with SMTP_PASS (a Google app password) emails are sent through Gmail
SMTP_PASS=
EMAIL_FROM=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
BLOB_READ_WRITE_TOKEN=
SKIP_EMAIL_VERIFICATION=      # 1 = auto-verify new accounts, no email (honoured only when APP_ENV is local or test)

# Push (APNs, token-based key; needs the Apple Developer Program). Empty = pushes are printed to the server log.
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_ENV=sandbox
