generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  BUSINESS_OWNER
  USER
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum EmailTokenType {
  VERIFY
  RESET
  EMAIL_CHANGE
}

enum BusinessType {
  BANK
  WALLET_PROVIDER
  MERCHANT
}

enum BusinessStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

enum CardType {
  DEBIT
  CREDIT
  PREPAID
}

enum PremiseStatus {
  ACTIVE
  INACTIVE
}

enum DiscountStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  PAUSED
  EXPIRED
  ARCHIVED
}

enum EligibilityScope {
  CARD_PRODUCT
  ISSUER_ANY
  ANY_BANK_CARD
  WALLET
  ANY_WALLET
  GENERAL
}

enum BenefitType {
  PERCENT
  FIXED
  CASHBACK
  BOGO
  FREE_ITEM
  POINTS
}

enum AlertEventType {
  TRIGGERED
  DELIVERED
  OPENED
  DISMISSED
  DETAIL_VIEWED
  SUPPRESSED
}

enum AlertMode {
  PERSONALISED
  PERSONALISED_PLUS_GENERAL
  ALL
}

enum DataOrigin {
  REAL
  SEED_VERIFIED
  SEED_ILLUSTRATIVE
  SYNTHETIC
}

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  email            String     @unique // stored lower-case (DEC-006)
  passwordHash     String     @map("password_hash")
  role             Role
  status           UserStatus @default(PENDING_VERIFICATION)
  firstName        String     @map("first_name")
  lastName         String     @map("last_name")
  phone            String?
  avatarUrl        String?    @map("avatar_url")
  locale           String     @default("pt-MZ")
  emailVerifiedAt  DateTime?  @map("email_verified_at")
  mfaSecretEnc     String?    @map("mfa_secret_enc") // AES-GCM encrypted
  mfaEnabled       Boolean    @default(false) @map("mfa_enabled")
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockCount        Int        @default(0) @map("lock_count")
  lockedUntil      DateTime?  @map("locked_until")
  dataOrigin       DataOrigin @default(REAL) @map("data_origin")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  deletedAt        DateTime?  @map("deleted_at")

  emailTokens   EmailToken[]
  sessions      Session[]
  refreshTokens RefreshToken[]
  devices       Device[]
  loginEvents   LoginEvent[]
  memberships   BusinessMember[]
  cards         UserCard[]
  wallets       UserWallet[]
  favorites     Favorite[]
  alertPref     AlertPreference?

  @@map("users")
}

model EmailToken {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      EmailTokenType
  tokenHash String         @unique @map("token_hash")
  newEmail  String?        @map("new_email")
  expiresAt DateTime       @map("expires_at")
  usedAt    DateTime?      @map("used_at")
  createdAt DateTime       @default(now()) @map("created_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

// Web portal server-side session (cookie holds the random id; only its hash is stored)
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  csrfToken  String    @map("csrf_token")
  mfaPassed  Boolean   @default(false) @map("mfa_passed")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at") // absolute 12h
  revokedAt  DateTime? @map("revoked_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// iOS rotating refresh token with reuse detection (family)
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  deviceId  String?   @map("device_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@map("refresh_tokens")
}

model Device {
  id                String         @id @default(uuid(7)) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  vendorId          String         @map("vendor_id")
  model             String?
  osVersion         String?        @map("os_version")
  appVersion        String?        @map("app_version")
  pushToken         String?        @map("push_token")
  biometricsEnabled Boolean        @default(false) @map("biometrics_enabled")
  lastSeenAt        DateTime       @default(now()) @map("last_seen_at")
  revokedAt         DateTime?      @map("revoked_at")
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens     RefreshToken[]
  loginEvents       LoginEvent[]

  @@unique([userId, vendorId])
  @@map("devices")
}

model LoginEvent {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  deviceId      String?  @map("device_id") @db.Uuid
  success       Boolean
  failureReason String?  @map("failure_reason")
  ip            String?
  userAgent     String?  @map("user_agent")
  coarseLat     Float?   @map("coarse_lat") // rounded to ~100 m by the API
  coarseLng     Float?   @map("coarse_lng")
  occurredAt    DateTime @default(now()) @map("occurred_at")
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  device        Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@map("login_events")
}

// Rate limits and lockout counters live in Postgres (POC, no Redis)
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime @map("window_start")

  @@map("rate_limits")
}

model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorEmail  String?  @map("actor_email")
  actorRole   String?  @map("actor_role")
  businessId  String?  @map("business_id") @db.Uuid
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  summary     String
  changes     Json?
  ip          String?
  userAgent   String?  @map("user_agent")
  deviceId    String?  @map("device_id")
  requestId   String?  @map("request_id")
  result      String   @default("success")

  @@index([occurredAt])
  @@index([action])
  @@index([actorUserId])
  @@map("audit_logs")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// IOS-5: which cards and wallets a person holds. Product only: never a card number, expiry, CVV or last 4 (assumption 3).
model UserCard {
  id            String      @id @default(uuid(7))
  userId        String      @map("user_id") @db.Uuid
  cardProductId String      @map("card_product_id")
  nickname      String?
  createdAt     DateTime    @default(now()) @map("created_at")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardProduct   CardProduct @relation(fields: [cardProductId], references: [id])

  @@unique([userId, cardProductId])
  @@map("user_cards")
}

model UserWallet {
  userId           String         @map("user_id") @db.Uuid
  walletProviderId String         @map("wallet_provider_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletProvider   WalletProvider @relation(fields: [walletProviderId], references: [id])

  @@id([userId, walletProviderId])
  @@map("user_wallets")
}

// IOS-5/IOS-8 preferences. Quiet hours are Maputo local "HH:MM".
model AlertPreference {
  userId         String    @id @map("user_id") @db.Uuid
  alertsEnabled  Boolean   @default(true) @map("alerts_enabled")
  mode           AlertMode @default(PERSONALISED)
  quietFrom      String?   @map("quiet_from")
  quietTo        String?   @map("quiet_to")
  generalIssuers String[]  @map("general_issuers")
  generalWallets String[]  @map("general_wallets")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("alert_preferences")
}

// IOS-7: the heart on a discount.
model Favorite {
  userId     String   @map("user_id") @db.Uuid
  discountId String   @map("discount_id")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@id([userId, discountId])
  @@index([discountId])
  @@map("favorites")
}

// BR-10: one row per alert lifecycle event reported by a device. Coarse location only (~100 m).
model AlertEvent {
  id            String         @id @default(uuid(7))
  clientEventId String?        @unique @map("client_event_id") // idempotency for the offline queue
  userId        String?        @map("user_id") @db.Uuid
  deviceId      String?        @map("device_id")
  premiseId     String         @map("premise_id")
  discountIds   String[]       @map("discount_ids")
  type          AlertEventType
  reason        String?
  occurredAt    DateTime       @map("occurred_at")
  receivedAt    DateTime       @default(now()) @map("received_at")
  distanceM     Int?           @map("distance_m")
  coarseLat     Float?         @map("coarse_lat")
  coarseLng     Float?         @map("coarse_lng")
  appVersion    String?        @map("app_version")
  osVersion     String?        @map("os_version")

  @@index([premiseId, occurredAt])
  @@index([type, occurredAt])
  @@index([userId, occurredAt])
  @@map("alert_events")
}

model Issuer {
  id           String        @id @default(uuid(7))
  name         String
  shortName    String        @map("short_name")
  logoUrl      String?       @map("logo_url")
  country      String        @default("MZ")
  note         String?
  active       Boolean       @default(true)
  dataOrigin   DataOrigin    @default(REAL) @map("data_origin")
  sourceUrl    String?       @map("source_url")
  cardProducts CardProduct[]
  businesses   Business[]

  @@map("issuers")
}

model CardNetwork {
  id           String        @id @default(uuid(7))
  name         String
  logoUrl      String?       @map("logo_url")
  active       Boolean       @default(true)
  cardProducts CardProduct[]

  @@map("card_networks")
}

model CardProduct {
  id         String      @id @default(uuid(7))
  issuerId   String      @map("issuer_id")
  networkId  String      @map("network_id")
  cardType   CardType    @map("card_type")
  segment    String
  name       String
  imageUrl   String?     @map("image_url")
  note       String?
  active     Boolean     @default(true)
  dataOrigin DataOrigin  @default(REAL) @map("data_origin")
  sourceUrl  String?     @map("source_url")
  issuer     Issuer      @relation(fields: [issuerId], references: [id])
  network    CardNetwork @relation(fields: [networkId], references: [id])
  holders    UserCard[]

  @@map("card_products")
}

model WalletProvider {
  id         String       @id @default(uuid(7))
  name       String
  operator   String
  logoUrl    String?      @map("logo_url")
  active     Boolean      @default(true)
  dataOrigin DataOrigin   @default(REAL) @map("data_origin")
  businesses Business[]
  holders    UserWallet[]

  @@map("wallet_providers")
}

model PremiseCategory {
  id        String    @id @default(uuid(7))
  namePt    String    @map("name_pt")
  nameEn    String    @map("name_en")
  icon      String
  sortOrder Int       @map("sort_order")
  active    Boolean   @default(true)
  premises  Premise[]

  @@map("premise_categories")
}

model Business {
  id               String           @id @default(uuid(7))
  type             BusinessType
  legalName        String?          @map("legal_name")
  tradingName      String           @map("trading_name")
  nuit             String?
  logoUrl          String?          @map("logo_url")
  brandColor       String?          @map("brand_color")
  description      String?
  website          String?
  contactEmail     String?          @map("contact_email")
  contactPhone     String?          @map("contact_phone")
  address          String?
  issuerId         String?          @map("issuer_id")
  walletProviderId String?          @map("wallet_provider_id")
  status           BusinessStatus   @default(DRAFT)
  rejectionReason  String?          @map("rejection_reason")
  approvedBy       String?          @map("approved_by") @db.Uuid
  approvedAt       DateTime?        @map("approved_at")
  dataOrigin       DataOrigin       @default(REAL) @map("data_origin")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  issuer           Issuer?          @relation(fields: [issuerId], references: [id])
  walletProvider   WalletProvider?  @relation(fields: [walletProviderId], references: [id])
  members          BusinessMember[]
  premises         Premise[]
  discounts        Discount[]

  @@map("businesses")
}

// POC: one owner per business, no staff role (assumption 5)
model BusinessMember {
  businessId String   @map("business_id")
  userId     String   @unique @map("user_id") @db.Uuid // one business per account
  invitedAt  DateTime @default(now()) @map("invited_at")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([businessId, userId])
  @@map("business_members")
}

// BR-8. Coordinates are optional: a premise without them is listed but never alerts (SD-5 pr-farmac-tbc).
model Premise {
  id           String            @id @default(uuid(7))
  businessId   String            @map("business_id")
  categoryId   String            @map("category_id")
  name         String
  address      String?
  city         String?
  province     String?
  lat          Float?
  lng          Float?
  approx       Boolean           @default(false)
  alertRadiusM Int               @default(150) @map("alert_radius_m")
  openingHours String?           @map("opening_hours")
  phone        String?
  status       PremiseStatus     @default(ACTIVE)
  dataOrigin   DataOrigin        @default(REAL) @map("data_origin")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  business     Business          @relation(fields: [businessId], references: [id])
  category     PremiseCategory   @relation(fields: [categoryId], references: [id])
  discounts    DiscountPremise[]

  @@index([businessId])
  @@index([lat, lng])
  @@map("premises")
}

// BR-7, BR-9. Dates are calendar dates in Africa/Maputo; valid_to is inclusive (BR-R2).
model Discount {
  id            String                @id @default(uuid(7))
  businessId    String                @map("business_id")
  titlePt       String                @map("title_pt")
  titleEn       String                @map("title_en")
  descriptionPt String?               @map("description_pt")
  descriptionEn String?               @map("description_en")
  termsPt       String?               @map("terms_pt")
  termsEn       String?               @map("terms_en")
  redemptionPt  String?               @map("redemption_pt")
  redemptionEn  String?               @map("redemption_en")
  promoCode     String?               @map("promo_code")
  validFrom     DateTime?             @map("valid_from") @db.Date
  validTo       DateTime?             @map("valid_to") @db.Date
  scheduleDays  String[]              @map("schedule_days") // MON..SUN, empty = every day
  scheduleFrom  String?               @map("schedule_from") // "HH:MM" Maputo
  scheduleTo    String?               @map("schedule_to")
  isOnline      Boolean               @default(false) @map("is_online")
  status        DiscountStatus        @default(DRAFT)
  dataOrigin    DataOrigin            @default(REAL) @map("data_origin")
  sourceRef     String?               @map("source_ref")
  publishedAt   DateTime?             @map("published_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  business      Business              @relation(fields: [businessId], references: [id])
  premises      DiscountPremise[]
  eligibility   DiscountEligibility[]
  favorites     Favorite[]

  @@index([businessId, status])
  @@map("discounts")
}

model DiscountPremise {
  discountId String   @map("discount_id")
  premiseId  String   @map("premise_id")
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  premise    Premise  @relation(fields: [premiseId], references: [id])

  @@id([discountId, premiseId])
  @@map("discount_premises")
}

model DiscountEligibility {
  id             String           @id @default(uuid(7))
  discountId     String           @map("discount_id")
  scope          EligibilityScope
  cardProductId  String?          @map("card_product_id")
  issuerId       String?          @map("issuer_id")
  walletId       String?          @map("wallet_id")
  cardType       CardType?        @map("card_type")
  networkId      String?          @map("network_id")
  benefit        BenefitType
  value          Float? // percent (0.01-100) for PERCENT/CASHBACK, points for POINTS
  valueMzn       Int?             @map("value_mzn")
  valueTextPt    String?          @map("value_text_pt")
  valueTextEn    String?          @map("value_text_en")
  minSpendMzn    Int?             @map("min_spend_mzn")
  maxDiscountMzn Int?             @map("max_discount_mzn")
  commentPt      String?          @map("comment_pt")
  commentEn      String?          @map("comment_en")
  position       Int              @default(0)
  discount       Discount         @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@index([discountId])
  @@map("discount_eligibility")
}
